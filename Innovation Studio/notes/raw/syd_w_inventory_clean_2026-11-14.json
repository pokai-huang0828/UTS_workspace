 "manifest_lines": 40,
 "rules": [
  {
   "rule": "價格字串去掉「,」「$」空白後轉成數字;轉不出來的當缺值",
   "why": "原始 price 是像 $1,200.00 的字串,不轉不能算",
   "source": "syd_a_market.py L68-L69(num);airbnb_ab_field_inventory.py L40-L45;syd_b_positioning.py L100;syd_c_hosts_time.py L63"
  },
  {
   "rule": "讀檔一律當字串、空白不當缺值(再自己轉數字)",
   "why": "避免 pandas 把「1」「01」或空字串亂轉",
   "source": "syd_a_market.py L61;syd_b_positioning.py L65"
  },
  {
   "rule": "「有開價」= price 欄不是空白",
   "why": "價格空白的房子沒有可比的價錢;2025-12 整欄空白所以那期沒有有開價的",
   "source": "syd_a_market.py L359;syd_b_positioning.py L99"
  },
  {
   "rule": "只留整套出租(room_type = Entire home/apt)",
   "why": "整套和只租一間房間的價錢不能直接比",
   "source": "syd_a_market.py L75;airbnb_ab_field_inventory.py L49"
  },
  {
   "rule": "只留 1 到 2 房(bedrooms 是 1 或 2)",
   "why": "新房東多半是小房子;房間數空白或 0 的不留",
   "source": "syd_a_market.py L75;airbnb_ab_field_inventory.py L49"
  },
  {
   "rule": "只留住 2 到 4 人(accommodates 2 到 4)",
   "why": "同樣大小的房子才比得起來",
   "source": "syd_a_market.py L73、L76;airbnb_ab_field_inventory.py L50"
  },
  {
   "rule": "只留最少住 1 到 7 晚(minimum_nights 1 到 7)",
   "why": "最少住很久的是長租,不是一般短租",
   "source": "syd_a_market.py L74、L76;airbnb_ab_field_inventory.py L51"
  },
  {
   "rule": "模型樣本再拿掉一晚超過 2,000 澳幣的(剛好 2,000 保留)",
   "why": "極端高價會把模型拉歪;中間價、分位數類統計不受影響所以其他地方仍用全部",
   "source": "syd_b_positioning.py L45(EXTREME_CAP)、L479(dm = d[d.price_num <= EXTREME_CAP])"
  },
  {
   "rule": "新手 = 當房東年資(hosts_time_as_host_years × 12 + hosts_time_as_host_months)不超過 12 個月(含剛好 12)",
   "why": "用平台給的年資欄推算;每期用自己那期的欄位值",
   "source": "syd_c_hosts_time.py L101(t_host)、L167(n12);notes/20 L158"
  },
  {
   "rule": "30 天不能訂的比例 = 抓取日(日曆最早那天)起 30 天內,available = f 的房源日 ÷ 全部房源日",
   "why": "不能訂可能是被訂走,也可能是房東自己關掉,分不出來,只能當作需求的參考",
   "source": "syd_a_market.py L109-L135(calendar_blocked)、L117(blk)"
  },
  {
   "rule": "評分中間值:review_scores_rating 轉數字、空白的不算",
   "why": "沒有評論的房子沒有分數",
   "source": "syd_a_market.py L415、L483"
  }
 ],
