        <named-connections>
          <named-connection caption='PoKaiHuang-26254793-A2-data' name='excel-direct.statistical'>
            <connection class='excel-direct' cleaning='no' compat='no' dataRefreshTime='' filename='D:\KennyCode\UTS_workspace\Data Visualisation and Visual Analytics\PoKaiHuang-26254793-A2-data.xlsx' interpretationMode='0' password='' server='' validate='no' />
